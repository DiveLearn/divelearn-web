---
// Cabecera morada de las páginas internas.
interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---

<section class="head">
  <div class="wrap">
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>

<style>
  .head {
    background: radial-gradient(120% 140% at 85% 0%, #6463f2 0%, var(--purple) 45%, var(--deep) 100%);
    color: var(--white);
    padding: 48px 0 40px;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
  }
  p {
    margin: 0;
    color: var(--lav);
    max-width: 52ch;
    font-size: 1.1rem;
  }
</style>
