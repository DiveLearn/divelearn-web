---
// Videojueguito del módulo 2 (binario): reemplaza a la actividad "Conversor binario".
import Base from "../../layouts/Base.astro";
import Sprite from "../../components/Sprite.astro";
import AvisoProgreso from "../../components/AvisoProgreso.astro";

const linternas = [128, 64, 32, 16, 8, 4, 2, 1];
---

<Base
  title="Linternas del abismo · juego de binario"
  description="Enciende las linternas justas para dar la luz que pide el rape del abismo: aprende binario y octetos de IP jugando."
>
  <link rel="stylesheet" href="/css/juego-dl.css" />
  <section class="wrap marco">
    <a class="volver" href="/bootcamp/modulo-2/">← Módulo 2 · Las direcciones secretas</a>

    <div class="juego" id="juego" style="--modulo:#ff7a8a">
      <div class="j-hud">
        <span class="j-titulo" id="j-titulo"></span>
        <span id="j-nivel">Nivel 1/5</span>
        <span class="j-ronda-caja">Ronda <b id="j-ronda">1/5</b><span class="j-ronda-pista"><span id="j-ronda-barra"></span></span></span>
        <span><i class="j-perla" aria-hidden="true"></i><b id="j-perlas">0</b> perlas</span>
      </div>

      <!-- Inicio -->
      <div class="j-pantalla j-centro" id="j-inicio">
        <Sprite nombre="guardiana-rape-abisal" escala={2.5} alt="Rape abisal con su farol" />
        <h1>Linternas del abismo</h1>
        <p>
          En el fondo del mar vive una rapa abisal que necesita luz exacta para ver. Tú tienes 8 linternas-pez, y cada
          una brilla el doble que la de su derecha. Enciende las justas para darle lo que pide.
        </p>
        <button type="button" class="j-btn" id="j-empezar">Bucear</button>
        <ol class="j-niveles" id="j-niveles" aria-label="Niveles"></ol>
      </div>

      <!-- Intro de nivel -->
      <div class="j-pantalla j-centro" id="j-intro" hidden>
        <span class="j-etiqueta" id="j-intro-num">Nivel 1</span>
        <h2 id="j-intro-titulo"></h2>
        <p id="j-intro-txt"></p>
        <button type="button" class="j-btn" id="j-intro-ir">¡Vamos!</button>
      </div>

      <!-- Tablero -->
      <div class="j-pantalla" id="j-tablero" hidden>
        <div class="escena">
          <div class="pedido" id="pedido" aria-live="polite">
            <Sprite nombre="guardiana-rape-abisal" escala={1.6} class="rape" alt="" />
            <div class="globo">
              <span class="ip" id="ip" hidden></span>
              <span id="pedido-txt">Necesito <b>0</b> lúmenes</span>
            </div>
          </div>
          <div class="luz" id="luz-caja">Luz: <b id="luz">0</b></div>
        </div>

        <div class="fila-linternas" id="linternas" role="group" aria-label="Linternas: teclas 1 a 8 para encender o apagar">
          {
            linternas.map((v, i) => (
              <button type="button" class="linterna" data-valor={v} aria-pressed="false" aria-label={`Linterna de ${v}`}>
                <Sprite nombre="linternin" escala={1.4} alt="" />
                <span class="valor">{v}</span>
                <span class="bit">0</span>
                <span class="tecla" aria-hidden="true">{i + 1}</span>
              </button>
            ))
          }
        </div>

        <div class="controles">
          <label class="respuesta" id="respuesta-caja" hidden>
            <span>¿Cuántos lúmenes son?</span>
            <input id="respuesta" type="number" min="0" max="255" inputmode="numeric" />
          </label>
          <button type="button" class="j-btn" id="iluminar">Iluminar <span class="kbd">Enter</span></button>
        </div>

        <div class="j-profe" id="j-profe">
          <img class="px" id="j-profe-img" src="/img/sprites/pulpo-profe.png" alt="Pulpo profe" width="56" />
          <p id="j-profe-txt"></p>
        </div>
      </div>

      <!-- Nivel superado -->
      <div class="j-pantalla j-centro" id="j-sube" hidden>
        <Sprite nombre="buzo-celebra" escala={2} alt="" />
        <h2>¡Nivel superado!</h2>
        <p id="j-sube-txt"></p>
        <button type="button" class="j-btn" id="j-sube-ir">Siguiente nivel</button>
      </div>

      <!-- Final -->
      <div class="j-pantalla j-centro" id="j-fin" hidden>
        <Sprite nombre="buzo-celebra" escala={2} alt="" />
        <h2>¡Hablas binario!</h2>
        <p>Terminaste con <b id="j-fin-perlas">0</b> perlas. Esto es lo que ya sabes:</p>
        <ul class="j-lista" id="j-fin-lista"></ul>
        <div class="fin-botones">
          <a class="j-btn" href="/bootcamp/modulo-2/">Volver al módulo 2</a>
          <button type="button" class="j-btn sec" id="j-fin-otra">Jugar otra vez</button>
        </div>
      </div>
    </div>
    <AvisoProgreso />
  </section>

  <script is:inline src="/js/juego-dl.js" defer></script>
  <script is:inline src="/js/juego-linternas.js" defer></script>
</Base>

<style>
  .marco {
    padding-top: 24px;
  }
  .volver {
    display: inline-block;
    margin-bottom: 12px;
    font: 700 0.875rem var(--pixel);
    color: var(--purple);
  }
  .escena {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }
  .pedido {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .globo {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--claro);
    color: var(--abismo);
    font-size: 1.1rem;
  }
  .globo b {
    font: 700 1.6rem var(--pixel);
    color: #b5401d;
  }
  .ip {
    font: 700 0.95rem ui-monospace, Menlo, monospace;
  }
  .ip :global(mark) {
    padding: 0 4px;
    border-radius: 4px;
    background: var(--lima);
    color: var(--abismo);
  }
  .luz {
    padding: 8px 14px;
    border: 1.5px dashed var(--lav);
    border-radius: 12px;
    font: 700 1rem var(--pixel);
    color: var(--lav);
  }
  .luz b {
    color: var(--lima);
  }
  .fila-linternas {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 8px;
  }
  .linterna {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    min-height: 120px;
    padding: 12px 4px 8px;
    border: 2px solid var(--abismo-2);
    border-radius: 14px;
    background: rgba(23, 21, 74, 0.7);
    color: var(--lav);
    transition: transform 0.12s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .linterna :global(img) {
    max-width: 100%;
    height: auto;
    filter: brightness(0.35) saturate(0.4);
    transition: filter 0.2s ease;
  }
  .linterna[aria-pressed="true"] {
    border-color: var(--lima);
    background: radial-gradient(circle at 50% 30%, rgba(224, 242, 74, 0.35), rgba(23, 21, 74, 0.7) 70%);
    transform: translateY(-4px);
  }
  .linterna[aria-pressed="true"] :global(img) {
    filter: drop-shadow(0 0 8px var(--lima));
  }
  .linterna:disabled {
    cursor: default;
  }
  .linterna.sugerida {
    outline: 2px dashed var(--lima);
    outline-offset: 3px;
  }
  .valor {
    font: 700 1rem var(--pixel);
    color: var(--claro);
  }
  .bit {
    font: 700 1.2rem ui-monospace, Menlo, monospace;
    color: var(--lav);
  }
  .linterna[aria-pressed="true"] .bit {
    color: var(--lima);
  }
  .tecla {
    position: absolute;
    top: 4px;
    left: 6px;
    font: 0.75rem ui-monospace, Menlo, monospace;
    opacity: 0.6;
  }
  .controles {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: end;
    justify-content: flex-end;
    margin-top: 18px;
  }
  .respuesta {
    display: grid;
    gap: 4px;
  }
  .respuesta input {
    width: 140px;
    min-height: 48px;
    padding: 6px 12px;
    border: 2px solid var(--lav);
    border-radius: 10px;
    background: var(--abismo);
    color: var(--claro);
    font: 700 1.3rem ui-monospace, Menlo, monospace;
  }
  .kbd {
    margin-left: 6px;
    padding: 1px 6px;
    border: 1px solid var(--abismo);
    border-radius: 5px;
    font-size: 0.8em;
    opacity: 0.7;
  }
  .fin-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .fin-botones a {
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .fila-linternas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .tecla,
    .kbd {
      display: none;
    }
  }
</style>
