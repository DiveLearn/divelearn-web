---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { etapas, rangos } from "../../data/bootcamp";

const modulos = etapas.flatMap((e) => e.modulos);
const juego = {
  modulos: etapas.flatMap((e) => e.modulos.map((m) => ({ n: m.n, xp: m.xp, titulo: m.titulo, etapa: e.id }))),
  etapas: etapas.map((e) => ({ id: e.id })),
  rangos,
};
---

<Base title="Bootcamp" description="Bootcamp gratis de fundamentos para la nube: redes, IP, DNS, seguridad, Linux, virtualización, datos y backup. Tu escuela de buceo antes de entrar al océano de AWS.">
  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <p class="kicker">Bootcamp gratis · Escuela de buceo</p>
        <h1>Antes del océano, <em>aprende a bucear</em></h1>
        <p class="lead">
          {modulos.length} módulos de fundamentos, en orden: de la teoría en la playa a tu primera inmersión de práctica.
          Al terminar te llevas tu <b>licencia de buceo</b> para entrar a la nube.
        </p>
        <a class="btn" href="#playa">Empezar el bootcamp</a>
      </div>
      <div class="licencia-mini" aria-hidden="true">
        <Icon name="identification-card" />
      </div>
    </div>
  </section>

  <aside class="hud" aria-label="Tu progreso">
    <div class="wrap hud-in">
      <div class="rango">
        <p class="rango-nombre" data-rango>{rangos[0].nombre}</p>
        <div class="barra" role="progressbar" aria-label="Progreso hacia tu licencia" aria-valuemin="0" aria-valuemax="100" data-barra-aria>
          <span data-barra></span>
        </div>
      </div>
      <p class="stat"><b data-xp>0</b> XP</p>
      <p class="stat"><b data-hechos>0</b>/{modulos.length} módulos</p>
      <p class="insignias" aria-label="Insignias por etapa">
        {
          etapas.map((e) => (
            <span title={`Insignia: ${e.nombre}`} data-insignia={e.id}>
              <Icon name={e.icono} />
            </span>
          ))
        }
      </p>
    </div>
  </aside>

  <div class="escuela">
    {
      etapas.map((e, ei) => (
        <section class="etapa" id={e.id} aria-labelledby={`t-${e.id}`}>
          <header class="wrap etapa-head">
            <span class="etapa-ico">
              <Icon name={e.icono} />
            </span>
            <div>
              <p class="paso">Etapa {ei + 1} de {etapas.length}</p>
              <h2 id={`t-${e.id}`}>{e.nombre}</h2>
              <p class="lema">{e.lema}</p>
            </div>
          </header>
          <ol class="wrap ruta">
            {e.modulos.map((m) => (
              <li class={`nivel ${m.n % 2 ? "der" : "izq"}`} data-modulo={m.n}>
                <a href={`/bootcamp/modulo-${m.n}/`} data-ir={m.n}>
                  <span class="nodo">
                    <Icon name={m.icono} />
                    <span class="num">{m.n}</span>
                  </span>
                  <span class="tarjeta">
                    <span class="estado">
                      Módulo {m.n} · {m.actividades} actividades + quiz
                    </span>
                    <span class="titulo">{m.titulo}</span>
                    <span class="tema">{m.tema}</span>
                    <span class="xp">+{m.xp} XP</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class="wrap meta" aria-labelledby="t-licencia">
      <div class="licencia" data-licencia>
        <span class="licencia-ico"><Icon name="identification-card" /></span>
        <div>
          <p class="paso" data-licencia-estado>Se desbloquea al terminar los {modulos.length} módulos</p>
          <h2 id="t-licencia">Licencia de buceo DiveLearn</h2>
          <p>
            Ya sabes cómo viajan los datos, cómo se protegen y dónde viven. Lo que sigue es el océano: tu primera
            certificación de AWS.
          </p>
          <div class="acciones">
            <a class="btn lime" href="/cursos/">Ver el océano (cursos)</a>
            <a class="btn ghost" href="https://mar31orvel.kit.com/inmersion-ans-c01">Avísame de las clases en video</a>
          </div>
        </div>
      </div>
      <button type="button" class="reiniciar" data-reiniciar>Reiniciar mi progreso</button>
    </section>
  </div>

  <div class="toast" role="status" aria-live="polite" data-toast></div>

  <script is:inline type="application/json" id="juego" set:html={JSON.stringify(juego)} />
  <script>
    // Progreso guardado solo en este navegador (sin cookies ni servidor).
    type Juego = {
      modulos: { n: number; xp: number; titulo: string; etapa: string }[];
      etapas: { id: string }[];
      rangos: { xp: number; nombre: string }[];
    };
    type Progreso = { hechos: number[]; ultimo?: string };

    const juego: Juego = JSON.parse(document.getElementById("juego")!.textContent!);
    const CLAVE = "divelearn-bootcamp";
    const $ = (s: string) => document.querySelector(s) as HTMLElement;

    const leer = (): Progreso => {
      try {
        return { hechos: [], ...JSON.parse(localStorage.getItem(CLAVE) || "{}") };
      } catch {
        return { hechos: [] };
      }
    };
    const guardar = (p: Progreso) => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify(p));
      } catch {
        /* modo privado: el juego funciona, solo no recuerda */
      }
    };

    function pintar(p: Progreso) {
      const xp = juego.modulos.filter((m) => p.hechos.includes(m.n)).reduce((a, m) => a + m.xp, 0);
      const total = juego.modulos.reduce((a, m) => a + m.xp, 0);
      const i = juego.rangos.findLastIndex((r) => xp >= r.xp);
      const pct = Math.round((xp / total) * 100);
      $("[data-rango]").textContent = juego.rangos[i].nombre;
      $("[data-xp]").textContent = xp.toLocaleString("es-ES");
      $("[data-hechos]").textContent = String(p.hechos.length);
      $("[data-barra]").style.width = pct + "%";
      $("[data-barra-aria]").setAttribute("aria-valuenow", String(pct));

      const siguiente = juego.modulos.find((m) => !p.hechos.includes(m.n));
      document.querySelectorAll<HTMLElement>("[data-modulo]").forEach((el) => {
        const n = Number(el.dataset.modulo);
        el.classList.toggle("hecho", p.hechos.includes(n));
        el.classList.toggle("siguiente", n === siguiente?.n);
      });
      juego.etapas.forEach((e) => {
        const completa = juego.modulos.filter((m) => m.etapa === e.id).every((m) => p.hechos.includes(m.n));
        $(`[data-insignia="${e.id}"]`).classList.toggle("ganada", completa);
      });
      const lista = !siguiente;
      $("[data-licencia]").classList.toggle("lista", lista);
      $("[data-licencia-estado]").textContent = lista
        ? "¡Desbloqueada! 🎉"
        : `Te faltan ${juego.modulos.length - p.hechos.length} módulos para desbloquearla`;
    }

    function avisar(texto: string) {
      const t = $("[data-toast]");
      t.textContent = texto;
      t.classList.add("ver");
      setTimeout(() => t.classList.remove("ver"), 3200);
    }

    let p = leer();
    pintar(p);
    if (p.ultimo) {
      avisar(p.ultimo);
      delete p.ultimo;
      guardar(p);
    }

    // Al entrar a un módulo se marca como explorado; el aviso de XP sale al volver.
    document.querySelectorAll<HTMLAnchorElement>("[data-ir]").forEach((a) =>
      a.addEventListener("click", () => {
        const m = juego.modulos.find((x) => x.n === Number(a.dataset.ir))!;
        if (p.hechos.includes(m.n)) return;
        p.hechos.push(m.n);
        p.ultimo = `+${m.xp} XP · ${m.titulo}`;
        guardar(p);
      }),
    );
    $("[data-reiniciar]").addEventListener("click", () => {
      p = { hechos: [] };
      guardar(p);
      pintar(p);
      avisar("Progreso reiniciado: de vuelta a la playa");
    });

    // Los niveles aparecen al bajar.
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("visto");
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.2 },
    );
    document.querySelectorAll(".nivel, .etapa-head, .licencia").forEach((el) => io.observe(el));
  </script>
</Base>

<style>
  /* Paleta estricta: blanco, morado, lavanda, lima y azul noche para el texto. */
  .intro {
    background: var(--purple);
    color: var(--white);
    padding: 56px 0;
    overflow: hidden;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 32px;
    align-items: center;
  }
  .kicker {
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--lav);
    margin: 0;
  }
  .intro h1 {
    font-size: clamp(2.3rem, 6vw, 3.8rem);
    margin-top: 10px;
  }
  .intro h1 em {
    color: var(--lime);
  }
  .lead {
    max-width: 48ch;
    margin: 0 0 24px;
    color: var(--lav);
    font-size: 1.1rem;
  }
  .lead b {
    color: var(--white);
  }
  .licencia-mini {
    justify-self: center;
    font-size: clamp(7rem, 16vw, 12rem);
    color: var(--white);
    --duo: var(--lime);
    animation: flotar 5s ease-in-out infinite;
    filter: drop-shadow(0 20px 30px rgba(31, 29, 92, 0.35));
  }
  @keyframes flotar {
    50% {
      transform: translateY(-12px) rotate(-3deg);
    }
  }

  /* ── Marcador ── */
  .hud {
    position: sticky;
    top: 59px;
    z-index: 5;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .hud-in {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-wrap: wrap;
  }
  .rango {
    flex: 1 1 220px;
  }
  .rango-nombre {
    margin: 0;
    font-family: var(--title);
    color: var(--purple);
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .barra {
    height: 8px;
    max-width: 260px;
    border-radius: 99px;
    background: var(--line);
    overflow: hidden;
    margin-top: 6px;
  }
  .barra span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 99px;
    background: var(--purple);
    transition: width 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .stat {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .stat b {
    color: var(--ink);
    font-size: 1.15rem;
  }
  .insignias {
    display: flex;
    gap: 6px;
    margin: 0;
  }
  .insignias span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.2rem;
    background: var(--lav-soft);
    color: var(--lav);
    --duo: var(--lav-soft);
    transition:
      transform 0.4s,
      background 0.4s,
      color 0.4s;
  }
  .insignias span.ganada {
    background: var(--purple);
    color: var(--white);
    --duo: var(--lime);
    transform: scale(1.1);
  }

  /* ── Etapas ── */
  .escuela {
    background: linear-gradient(180deg, var(--white), var(--lav-soft));
    padding-bottom: 32px;
  }
  .etapa {
    padding: 64px 0 8px;
  }
  .etapa-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s,
      transform 0.6s;
  }
  .etapa-ico {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: var(--purple);
    color: var(--white);
    font-size: 2rem;
    --duo: var(--lime);
    transform: rotate(-6deg);
  }
  .paso {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .etapa-head h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    color: var(--ink);
    margin: 2px 0;
  }
  .lema {
    margin: 0;
    color: var(--muted);
  }

  /* ── Ruta de módulos ── */
  .ruta {
    list-style: none;
    margin: 32px auto 0;
    max-width: 760px;
    position: relative;
  }
  .ruta::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-left: 3px dashed var(--lav);
    transform: translateX(-50%);
  }
  .nivel {
    position: relative;
    margin-bottom: 28px;
    opacity: 0;
    transform: translateY(30px) scale(0.96);
    transition:
      opacity 0.6s,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .visto {
    opacity: 1 !important;
    transform: none !important;
  }
  .nivel a {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--ink);
  }
  .nodo {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 28px;
    background: var(--white);
    color: var(--purple);
    font-size: 2.6rem;
    --duo: var(--lav);
    border: 2px solid var(--line);
    box-shadow: 0 12px 30px rgba(84, 83, 235, 0.16);
    transition:
      transform 0.25s,
      background 0.3s;
  }
  .num {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--purple);
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .tarjeta {
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgba(84, 83, 235, 0.08);
    transition:
      transform 0.25s,
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .izq .tarjeta {
    grid-column: 1;
    text-align: right;
  }
  .der .tarjeta {
    grid-column: 3;
  }
  .estado {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .titulo {
    font-family: var(--title);
    font-size: 1.35rem;
    color: var(--purple);
    line-height: 1.15;
  }
  .tema {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .xp {
    align-self: flex-start;
    margin-top: 4px;
    padding: 2px 10px;
    border-radius: 99px;
    background: var(--lav-soft);
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .izq .xp {
    align-self: flex-end;
  }
  .nivel a:hover .nodo,
  .nivel a:focus-visible .nodo {
    transform: scale(1.08) rotate(-4deg);
  }
  .nivel a:hover .tarjeta {
    transform: translateY(-3px);
    border-color: var(--lav);
    box-shadow: 0 16px 36px rgba(84, 83, 235, 0.16);
  }
  .siguiente .nodo {
    background: var(--purple);
    color: var(--white);
    --duo: var(--lime);
    border-color: var(--purple);
    animation: latir 1.8s ease-in-out infinite;
  }
  .siguiente .num {
    background: var(--lime);
    color: var(--ink);
  }
  .siguiente .estado::before {
    content: "▶ Sigue aquí · ";
    color: var(--purple);
  }
  @keyframes latir {
    50% {
      box-shadow: 0 0 0 10px rgba(84, 83, 235, 0.15);
    }
  }
  .hecho .nodo {
    background: var(--lime);
    color: var(--ink);
    --duo: var(--white);
    border-color: var(--lime);
  }
  .hecho .num {
    background: var(--ink);
    font-size: 0;
  }
  .hecho .num::after {
    content: "✓";
    font-size: 0.95rem;
  }
  .hecho .xp {
    background: var(--lime);
    color: var(--ink);
  }
  .hecho .estado::before {
    content: "Completado · ";
    color: var(--ink);
  }

  /* ── Licencia ── */
  .meta {
    padding-top: 56px;
    max-width: 760px;
  }
  .licencia {
    display: flex;
    gap: 24px;
    align-items: center;
    padding: 28px;
    border-radius: 28px;
    border: 2px dashed var(--lav);
    background: var(--white);
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s,
      transform 0.6s;
  }
  .licencia-ico {
    flex: 0 0 auto;
    font-size: 5rem;
    color: var(--lav);
    --duo: var(--lav-soft);
    transition: color 0.4s;
  }
  .licencia h2 {
    color: var(--ink);
    font-size: 1.8rem;
    margin: 4px 0 8px;
  }
  .licencia p {
    color: var(--muted);
  }
  .licencia .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .licencia .btn.ghost {
    color: var(--purple);
    box-shadow: inset 0 0 0 2px var(--lav);
  }
  .licencia.lista {
    border: 0;
    background: var(--purple);
    color: var(--white);
    box-shadow: 0 20px 50px rgba(84, 83, 235, 0.35);
    position: relative;
    overflow: hidden;
  }
  .licencia.lista::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 40%, rgba(255, 255, 255, 0.35) 50%, transparent 60%);
    transform: translateX(-100%);
    animation: brillo 3.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes brillo {
    60%,
    100% {
      transform: translateX(100%);
    }
  }
  .licencia.lista h2,
  .licencia.lista .btn.ghost {
    color: var(--white);
  }
  .licencia.lista p,
  .licencia.lista .paso {
    color: var(--lav);
  }
  .licencia.lista .licencia-ico {
    color: var(--white);
    --duo: var(--lime);
  }
  .reiniciar {
    display: block;
    margin: 24px auto 0;
    background: none;
    border: 0;
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    min-height: 44px;
  }

  /* ── Aviso de XP ── */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    padding: 14px 22px;
    border-radius: 99px;
    background: var(--ink);
    color: var(--lime);
    font-weight: 700;
    box-shadow: 0 12px 30px rgba(31, 29, 92, 0.35);
    transform: translate(-50%, 140%);
    visibility: hidden;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.45s;
    max-width: calc(100% - 32px);
  }
  .toast.ver {
    transform: translate(-50%, 0);
    visibility: visible;
  }

  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .licencia-mini {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .hud {
      top: 58px;
    }
    .hud-in {
      gap: 8px 16px;
    }
    .rango {
      flex-basis: 100%;
    }
    .etapa-head {
      justify-content: flex-start;
    }
    .ruta::before {
      left: 36px;
    }
    .nivel a {
      grid-template-columns: 72px 1fr;
      gap: 12px;
    }
    .nodo {
      grid-column: 1;
      width: 72px;
      height: 72px;
      font-size: 2.1rem;
      border-radius: 22px;
    }
    .izq .tarjeta,
    .der .tarjeta {
      grid-column: 2;
      text-align: left;
    }
    .izq .xp {
      align-self: flex-start;
    }
    .licencia {
      flex-direction: column;
      text-align: center;
    }
    .licencia .acciones {
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nivel,
    .etapa-head,
    .licencia {
      opacity: 1;
      transform: none;
    }
  }
</style>
