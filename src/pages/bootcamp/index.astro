---
import "@fontsource/silkscreen/700.css";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Pixel from "../../components/Pixel.astro";
import { etapas, rangos, XP } from "../../data/bootcamp";
import paginas from "../../data/bootcamp-paginas.json";
import { PALETA, PALMERA, ISLA, NUBE, COFRE, BURBUJA, TANQUE } from "../../data/sprites";

// Personajes pixel diseñados con Gemini y limpiados con scripts/recortar-sprites.py (PNG a 1x).
const sprite = (n: string, w: number, h: number, x: number) => ({ src: `/img/sprites/${n}.png`, width: w * x, height: h * x });

const pags = paginas as Record<string, string[]>;
const xpDe = (slug: string) => (slug.startsWith("quiz") ? XP.quiz : XP.actividad);
const modulos = etapas.flatMap((e) =>
  e.modulos.map((m) => ({ ...m, etapa: e.id, color: e.color, paginas: pags[m.n] ?? [], xp: (pags[m.n] ?? []).reduce((a, s) => a + xpDe(s), 0) })),
);
const total = modulos.reduce((a, m) => a + m.xp, 0);
const juego = {
  modulos: modulos.map((m) => ({ n: m.n, titulo: m.titulo, etapa: m.etapa, comando: m.comando, paginas: m.paginas, xp: m.xp })),
  etapas: etapas.map((e) => ({ id: e.id })),
  rangos: rangos.map((r) => ({ nombre: r.nombre, xp: Math.round(r.parte * total) })),
  xp: XP,
  total,
};
const camino = [
  ...etapas.map((e) => ({ id: e.id, icono: e.icono, color: e.color, nombre: e.nombre })),
  { id: "licencia", icono: "identification-card", color: "#e0f24a", nombre: "Licencia" },
];
---

<Base title="Bootcamp" description="Bootcamp gratis de fundamentos para la nube, como un videojuego: redes, IP, DNS, seguridad, Linux, virtualización, datos y backup. Gana XP, sube de rango y llévate tu licencia de buceo.">
  <div class="juego">
    <!-- ── Portada ── -->
    <section class="wrap portada">
      <h1 class="titulo-pixel">BOOTCAMP DIVELEARN</h1>
      <p class="sub-pixel">Aprende cloud. <span>Como un videojuego.</span></p>

      <div class="pantalla" aria-label="Escena del juego: un buzo en el mar junto a una isla">
        <div class="hud-juego">
          <div class="tanques" title="Racha de días seguidos" data-tanques>
            {Array.from({ length: 5 }, () => <Pixel mapa={TANQUE} paleta={PALETA} escala={5} class="tanque" />)}
          </div>
          <div class="nivel-hud">
            <span class="nv">Nv. <b data-nv>1</b></span>
            <span class="mini-barra"><span data-mini-barra></span></span>
          </div>
          <div class="monedas"><b data-xp-hud>0</b> XP</div>
        </div>
        <div class="cielo">
          <Pixel mapa={NUBE} paleta={PALETA} escala={7} class="nube n1" />
          <Pixel mapa={NUBE} paleta={PALETA} escala={5} class="nube n2" />
          <span class="sol" aria-hidden="true"></span>
        </div>
        <div class="isla">
          <Pixel mapa={PALMERA} paleta={PALETA} escala={8} class="palmera" />
          <Pixel mapa={ISLA} paleta={PALETA} escala={8} />
        </div>
        <div class="mar">
          <span class="ola o1"></span><span class="ola o2"></span>
          <img class="px buzo" {...sprite("buzo-nada", 89, 44, 2.6)} alt="La buzo de DiveLearn nadando" />
          <img class="px pez p1" {...sprite("pez-payaso", 46, 32, 1.6)} alt="" />
          <img class="px tortuga" {...sprite("tortuga", 70, 42, 1.8)} alt="" />
          <img class="px medusa" {...sprite("medusa", 31, 44, 1.6)} alt="" />
          <Pixel mapa={BURBUJA} paleta={PALETA} escala={4} class="burbuja u1" />
          <Pixel mapa={BURBUJA} paleta={PALETA} escala={3} class="burbuja u2" />
          <Pixel mapa={COFRE} paleta={PALETA} escala={6} class="cofre" />
          <span class="fondo-arena"></span>
        </div>
        <div class="consola" aria-hidden="true">
          <span class="puntos"><i></i><i></i><i></i></span>
          <code>$ divelearn start --bootcamp<br /><em># tu inmersión empieza aquí</em></code>
        </div>
      </div>

      <ol class="camino" aria-label="Etapas del bootcamp">
        {
          camino.map((c, i) => (
            <li style={`--c:${c.color}`} data-camino={c.id}>
              <a href={`#${c.id}`}>
                <span class="bola">
                  <Icon name={c.icono} />
                  <span class="n">{i + 1}</span>
                </span>
                <span class="etq">{c.nombre}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── Progreso + misión ── -->
    <section class="wrap paneles">
      <article class="panel">
        <header class="barra-titulo"><h2>Tu progreso</h2><span class="puntos"><i></i><i></i><i></i></span></header>
        <div class="perfil">
          <div class="avatar"><img class="px" {...sprite("buzo-saluda", 44, 62, 1.4)} alt="Tu buzo" /></div>
          <div class="perfil-txt">
            <p class="rango" data-rango>{juego.rangos[0].nombre}</p>
            <div class="barra-xp"><span data-barra></span></div>
            <p class="xp-txt"><b data-xp>0</b> / {total.toLocaleString("es-ES")} XP</p>
          </div>
        </div>
        <div class="stats">
          <div class="stat"><Icon name="fire" /><b data-racha>0</b><span>días de racha</span></div>
          <div class="stat"><Icon name="clock" /><b data-min>0 min</b><span>hoy</span></div>
          <div class="stat"><Icon name="chart-bar" /><b data-pct>0%</b><span>completado</span></div>
        </div>
      </article>

      <article class="panel">
        <header class="barra-titulo"><h2>Misión del día</h2><span class="puntos"><i></i><i></i><i></i></span></header>
        <div class="profe">
          <img class="px" {...sprite("pulpo-profe", 48, 46, 1.5)} alt="El pulpo profe" />
          <p class="mision"><span class="check" data-mision-check></span><span data-mision>Abre tu primera actividad del bootcamp.</span></p>
        </div>
        <div class="terminal">
          <span class="puntos"><i></i><i></i><i></i></span>
          <code data-comando>$ curl -I https://divelearn.cloud</code>
        </div>
        <a class="btn-jugar" href="/bootcamp/modulo-0/" data-jugar>▶ Jugar</a>
      </article>
    </section>

    <!-- ── Etapas ── -->
    {
      etapas.map((e, ei) => (
        <section class="wrap etapa" id={e.id} style={`--c:${e.color}`} aria-labelledby={`t-${e.id}`}>
          <div class="panel etapa-panel">
            <header class="barra-titulo color">
              <h2 id={`t-${e.id}`}>
                <Icon name={e.icono} /> Etapa {ei + 1} · {e.nombre}
              </h2>
              <span class="avance" data-avance={e.id}>0/{e.modulos.length}</span>
            </header>
            <p class="lema">{e.lema}</p>
            <ol class="modulos">
              {modulos
                .filter((m) => m.etapa === e.id)
                .map((m) => (
                  <li data-modulo={m.n}>
                    <a href={`/bootcamp/modulo-${m.n}/`}>
                      <span class="ico-mod">
                        <Icon name={m.icono} />
                      </span>
                      <span class="mod-txt">
                        <span class="mod-n">
                          Módulo {m.n} <span class="estado" data-estado />
                        </span>
                        <span class="mod-t">{m.titulo}</span>
                        <span class="mod-d">{m.tema}</span>
                        <span class="mod-barra">
                          <span data-mod-barra />
                        </span>
                        <span class="mod-pie">
                          <span data-mod-cuenta>0/{m.paginas.length} actividades</span>
                          <span class="mod-xp">+{m.xp} XP</span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
            </ol>
          </div>
        </section>
      ))
    }

    <!-- ── Licencia ── -->
    <section class="wrap etapa" id="licencia">
      <div class="panel licencia" data-licencia>
        <header class="barra-titulo"><h2><Icon name="identification-card" /> Licencia de buceo</h2><span class="puntos"><i></i><i></i><i></i></span></header>
        <div class="licencia-cuerpo">
          <Pixel mapa={COFRE} paleta={PALETA} escala={9} class="cofre-grande" />
          <div>
            <p class="estado-licencia" data-licencia-estado>Se desbloquea al completar todo el bootcamp</p>
            <p>Ya sabes cómo viajan los datos, cómo se protegen y dónde viven. Lo que sigue es el océano: tu primera certificación de AWS.</p>
            <div class="acciones">
              <a class="btn-jugar" href="/cursos/">▶ Ir al océano</a>
              <a class="btn-sec" href="https://mar31orvel.kit.com/inmersion-ans-c01">Avísame de las clases en video</a>
            </div>
          </div>
        </div>
      </div>
      <button type="button" class="reiniciar" data-reiniciar>Reiniciar mi progreso</button>
    </section>
  </div>

  <!-- ── Subida de rango ── -->
  <div class="subida" role="dialog" aria-modal="true" aria-labelledby="t-subida" hidden data-subida>
    <div class="panel subida-caja">
      <img class="px" {...sprite("buzo-saluda", 44, 62, 2)} alt="" />
      <p class="subida-kicker">¡Subiste de rango!</p>
      <h2 id="t-subida" data-subida-rango></h2>
      <button type="button" class="btn-jugar" data-subida-ok>¡Vamos!</button>
    </div>
  </div>
  <canvas class="confeti" aria-hidden="true" data-confeti></canvas>

  <script is:inline src="/js/bootcamp-progreso.js"></script>
  <script is:inline type="application/json" id="juego" set:html={JSON.stringify(juego)} />
  <script>
    type Mod = { n: number; titulo: string; etapa: string; comando: string; paginas: string[]; xp: number };
    type Juego = {
      modulos: Mod[];
      etapas: { id: string }[];
      rangos: { nombre: string; xp: number }[];
      xp: { actividad: number; quiz: number };
      total: number;
    };
    type Progreso = {
      v: 2;
      visitas: Record<string, string[]>;
      dias: string[];
      seg: Record<string, number>;
      ultimaNueva?: string;
      xpVisto?: number;
      rangoVisto?: number;
    };
    const api = (window as any).DiveLearnProgreso as { leer: () => Progreso; guardar: (p: Progreso) => void; hoy: string };
    const juego: Juego = JSON.parse(document.getElementById("juego")!.textContent!);
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const xpPagina = (slug: string) => (slug.startsWith("quiz") ? juego.xp.quiz : juego.xp.actividad);

    function estado(p: Progreso) {
      const mods = juego.modulos.map((m) => {
        const vistas = (p.visitas[m.n] ?? []).filter((s) => m.paginas.includes(s));
        return { ...m, vistas, xpHecho: vistas.reduce((a, s) => a + xpPagina(s), 0), completo: vistas.length >= m.paginas.length };
      });
      const xp = mods.reduce((a, m) => a + m.xpHecho, 0);
      const rango = juego.rangos.findLastIndex((r) => xp >= r.xp);
      return { mods, xp, rango };
    }

    function racha(dias: string[]) {
      const set = new Set(dias);
      const d = new Date();
      if (!set.has(api.hoy)) d.setDate(d.getDate() - 1); // la racha sigue viva hasta que termine hoy
      let n = 0;
      while (set.has(d.toLocaleDateString("sv"))) {
        n++;
        d.setDate(d.getDate() - 1);
      }
      return n;
    }

    function contar(el: HTMLElement, desde: number, hasta: number) {
      if (reducido || desde === hasta) {
        el.textContent = hasta.toLocaleString("es-ES");
        return;
      }
      const t0 = performance.now();
      const paso = (t: number) => {
        const k = Math.min(1, (t - t0) / 1200);
        el.textContent = Math.round(desde + (hasta - desde) * (1 - Math.pow(1 - k, 3))).toLocaleString("es-ES");
        if (k < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }

    function pintar(p: Progreso, animar: boolean) {
      const { mods, xp, rango } = estado(p);
      const desde = animar ? Math.min(p.xpVisto ?? 0, xp) : xp;
      contar($("[data-xp]"), desde, xp);
      contar($("[data-xp-hud]"), desde, xp);
      const r = juego.rangos[rango];
      const sig = juego.rangos[rango + 1];
      $("[data-rango]").textContent = r.nombre;
      $("[data-nv]").textContent = String(rango + 1);
      $("[data-barra]").style.width = Math.round((xp / juego.total) * 100) + "%";
      $("[data-mini-barra]").style.width = (sig ? Math.round(((xp - r.xp) / (sig.xp - r.xp)) * 100) : 100) + "%";
      $("[data-pct]").textContent = Math.round((xp / juego.total) * 100) + "%";
      const dias = racha(p.dias);
      $("[data-racha]").textContent = String(dias);
      document.querySelectorAll<SVGElement>("[data-tanques] .tanque").forEach((t, i) => t.classList.toggle("vacio", i >= Math.max(1, dias)));
      $("[data-min]").textContent = Math.round((p.seg[api.hoy] ?? 0) / 60) + " min";

      // Módulos y etapas
      const siguiente = mods.find((m) => !m.completo);
      mods.forEach((m) => {
        const li = $(`[data-modulo="${m.n}"]`);
        li.classList.toggle("hecho", m.completo);
        li.classList.toggle("en-curso", !m.completo && m.vistas.length > 0);
        li.classList.toggle("siguiente", m.n === siguiente?.n);
        (li.querySelector("[data-mod-barra]") as HTMLElement).style.width = Math.round((m.vistas.length / m.paginas.length) * 100) + "%";
        li.querySelector("[data-mod-cuenta]")!.textContent = `${m.vistas.length}/${m.paginas.length} actividades`;
        li.querySelector("[data-estado]")!.textContent = m.completo ? "✓ completo" : m.n === siguiente?.n ? "▶ sigue aquí" : m.vistas.length ? "en curso" : "";
      });
      juego.etapas.forEach((e) => {
        const de = mods.filter((m) => m.etapa === e.id);
        const listos = de.filter((m) => m.completo).length;
        $(`[data-avance="${e.id}"]`).textContent = `${listos}/${de.length}`;
        $(`[data-camino="${e.id}"]`).classList.toggle("hecho", listos === de.length);
      });
      const todo = !siguiente;
      $(`[data-camino="licencia"]`).classList.toggle("hecho", todo);
      $("[data-licencia]").classList.toggle("lista", todo);
      $("[data-licencia-estado]").textContent = todo
        ? "¡Desbloqueada! Ya eres buzo con licencia 🎉"
        : `Te faltan ${mods.filter((m) => !m.completo).length} módulos para desbloquearla`;

      // Misión del día: abrir al menos una actividad nueva hoy.
      if (siguiente) {
        const pag = siguiente.paginas.find((s) => !siguiente.vistas.includes(s)) ?? siguiente.paginas[0];
        $("[data-mision]").textContent = `Completa una actividad nueva del Módulo ${siguiente.n}: ${siguiente.titulo}.`;
        $("[data-comando]").textContent = (siguiente.comando.startsWith("SELECT") ? "" : "$ ") + siguiente.comando;
        ($("[data-jugar]") as HTMLAnchorElement).href = `/bootcamp/modulo-${siguiente.n}/${pag}.html`;
        $("[data-jugar]").textContent = mods.some((m) => m.vistas.length) ? "▶ Seguir donde quedaste" : "▶ Jugar";
      } else {
        $("[data-mision]").textContent = "¡Bootcamp completo! Reclama tu licencia de buceo.";
        ($("[data-jugar]") as HTMLAnchorElement).href = "#licencia";
      }
      $("[data-mision-check]").classList.toggle("ok", p.ultimaNueva === api.hoy);
      return { xp, rango };
    }

    // ── Confeti en colores del juego ──
    function confeti() {
      if (reducido) return;
      const cv = $("[data-confeti]") as unknown as HTMLCanvasElement;
      const cx = cv.getContext("2d")!;
      cv.width = innerWidth;
      cv.height = innerHeight;
      const colores = ["#5453eb", "#e0f24a", "#b2cafd", "#ff7a8a", "#ffd36e", "#7cc6fe", "#04a8bb"];
      const ps = Array.from({ length: 140 }, () => ({
        x: innerWidth / 2,
        y: innerHeight / 3,
        vx: (Math.random() - 0.5) * 16,
        vy: Math.random() * -14 - 4,
        s: 6 + Math.random() * 6,
        c: colores[Math.floor(Math.random() * colores.length)],
      }));
      const t0 = performance.now();
      const paso = (t: number) => {
        cx.clearRect(0, 0, cv.width, cv.height);
        ps.forEach((q) => {
          q.vy += 0.4;
          q.x += q.vx;
          q.y += q.vy;
          cx.fillStyle = q.c;
          cx.fillRect(Math.round(q.x), Math.round(q.y), q.s, q.s); // confeti cuadrado, estilo pixel
        });
        if (t - t0 < 2600) requestAnimationFrame(paso);
        else cx.clearRect(0, 0, cv.width, cv.height);
      };
      requestAnimationFrame(paso);
    }

    let p = api.leer();
    const { xp, rango } = pintar(p, true);
    if (rango > (p.rangoVisto ?? 0)) {
      $("[data-subida-rango]").textContent = juego.rangos[rango].nombre;
      $("[data-subida]").hidden = false;
      ($("[data-subida-ok]") as HTMLButtonElement).focus();
      confeti();
    }
    p.xpVisto = xp;
    p.rangoVisto = rango;
    api.guardar(p);

    $("[data-subida-ok]").addEventListener("click", () => ($("[data-subida]").hidden = true));
    $("[data-reiniciar]").addEventListener("click", () => {
      p = { v: 2, visitas: {}, dias: [api.hoy], seg: {} };
      api.guardar(p);
      pintar(p, false);
    });

    // Los paneles aparecen al bajar.
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("visto");
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.15 },
    );
    document.querySelectorAll(".etapa .panel, .paneles .panel").forEach((el) => io.observe(el));
  </script>
</Base>

<style>
  /* Estética de videojuego retro: letra pixel, bordes gruesos azul noche y sombra dura.
     Paleta del juego = marca + arena, coral, cielo y turquesa (una por etapa). */
  .juego {
    --borde: 3px solid var(--ink);
    --sombra: 6px 6px 0 var(--ink);
    --pixel: "Silkscreen", ui-monospace, monospace;
    --negrita: 700 1em var(--body);
    --fondo: #e9e4fb;
    background:
      radial-gradient(circle at 1px 1px, rgba(84, 83, 235, 0.12) 1px, transparent 0) 0 0 / 22px 22px,
      var(--fondo);
    padding-bottom: 40px;
    font-family: var(--body);
  }
  .juego :global(h2) {
    font-family: var(--pixel);
  }
  .puntos {
    display: inline-flex;
    gap: 6px;
  }
  .puntos i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: #ff7a8a;
  }
  .puntos i:nth-child(2) {
    background: #ffd36e;
  }
  .puntos i:nth-child(3) {
    background: #6fd08c;
  }

  /* ── Portada ── */
  .portada {
    padding-top: 40px;
    text-align: center;
  }
  .titulo-pixel {
    font-family: var(--pixel);
    font-weight: 700;
    font-size: clamp(2rem, 6.4vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: 0;
    color: #ffd36e;
    margin: 0;
    text-shadow:
      3px 0 0 var(--ink),
      -3px 0 0 var(--ink),
      0 3px 0 var(--ink),
      0 -3px 0 var(--ink),
      3px 3px 0 var(--ink),
      -3px -3px 0 var(--ink),
      3px -3px 0 var(--ink),
      -3px 3px 0 var(--ink),
      7px 7px 0 var(--purple);
  }
  .sub-pixel {
    font-family: var(--pixel);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.8vw, 1.8rem);
    line-height: 1.3;
    color: var(--ink);
    margin: 18px 0 30px;
  }
  .sub-pixel span {
    color: var(--purple);
  }

  /* Pantalla del juego */
  .pantalla {
    position: relative;
    height: clamp(300px, 42vw, 440px);
    border: 8px solid var(--ink);
    border-radius: 34px;
    overflow: hidden;
    box-shadow: 10px 10px 0 rgba(31, 29, 92, 0.35);
    background: linear-gradient(#9fd8ff, #cdeaff 55%);
    text-align: left;
  }
  .hud-juego {
    position: absolute;
    inset: 14px 16px auto;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font: 700 1rem var(--body);
    color: var(--white);
  }
  .tanques {
    display: flex;
    gap: 4px;
  }
  .tanques :global(.vacio) {
    opacity: 0.3;
    filter: grayscale(1);
  }
  .nivel-hud,
  .monedas {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 3px solid var(--ink);
    border-radius: 10px;
    background: rgba(31, 29, 92, 0.85);
  }
  .nv b,
  .monedas b {
    color: var(--lime);
  }
  .mini-barra {
    width: 80px;
    height: 10px;
    border: 2px solid var(--white);
    border-radius: 4px;
    overflow: hidden;
  }
  .mini-barra span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--lime);
    transition: width 1s;
  }
  .pantalla :global(.cielo .nube) {
    position: absolute;
    animation: deriva 40s linear infinite;
  }
  .pantalla :global(.n1) {
    top: 70px;
    left: 10%;
  }
  .pantalla :global(.n2) {
    top: 120px;
    left: 60%;
    animation-duration: 55s !important;
  }
  @keyframes deriva {
    to {
