---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
const niveles = [
  { n: "Superficie", cert: "Cloud Practitioner", d: "Tu primera certificación: qué es la nube, servicios clave, seguridad y costos.", estado: "Próximamente", href: "/lista/", cta: "Avísame" },
  { n: "Arrecife", cert: "Associate", d: "Arquitectura, desarrollo y operación en AWS con laboratorios reales.", estado: "Próximamente", href: "/lista/", cta: "Avísame" },
  { n: "Profundidad", cert: "Professional", d: "Diseño de soluciones complejas, multi-cuenta y a gran escala.", estado: "Más adelante", href: "/lista/", cta: "Avísame" },
  { n: "Abismo", cert: "Specialty", d: "Inmersión ANS-C01: redes avanzadas con 30 especies, mapas interactivos y tu fecha de examen.", estado: "Gratis", href: "/inmersion-ans-c01/", cta: "Empezar a bucear" },
];
const opiniones = [
  { q: "Llevo como cuatro años, por fin. Ya me siento mucho más confiada.", n: "Andrea R." },
  { q: "Yo ya tenía que ver con AWS por proyectos, pero no me sentía seguro.", n: "Isaac C." },
  { q: "Yo aprendo de una manera muy didáctica y muy rápida, y me siento muy confiado.", n: "Camilo C." },
];
---

<Base title="Cursos" description="Certifícate en AWS entendiendo lo que haces, no memorizando. Cursos por niveles de profundidad, gamificados y en español.">
  <PageHead title="Cursos" lead="Certifícate en AWS entendiendo lo que haces, no memorizando. Bajas por niveles de profundidad, a tu ritmo." />

  <section class="wrap bloque">
    <div class="previa">
      <div>
        <p class="kicker">Antes de bajar</p>
        <h2>Empieza por el bootcamp gratis</h2>
        <p>Redes, seguridad, Linux y datos: lo que todos los cursos de AWS dan por sabido. Sin instalar nada.</p>
      </div>
      <a class="btn lime" href="/bootcamp/">Empezar el bootcamp</a>
    </div>
  </section>

  <section class="wrap bloque">
    <h2>Tu ruta de profundidad</h2>
    <ol class="niveles">
      {
        niveles.map((v, i) => (
          <li class={v.estado === "Gratis" ? "on" : ""}>
            <span class="prof">{String(i + 1).padStart(2, "0")} · {v.n}</span>
            <h3>{v.cert}</h3>
            <p>{v.d}</p>
            <span class={`tag ${v.estado === "Gratis" ? "lima" : ""}`}>{v.estado}</span>
            <a class="ir" href={v.href}>
              {v.cta} →
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="opiniones">
    <div class="wrap">
      <h2>Lo que dijeron en el curso Navegando en AWS</h2>
      <p class="intro">El curso en vivo de Cloud Practitioner que di en 2025. La nueva versión llega pronto.</p>
      <div class="citas">
        {
          opiniones.map((o) => (
            <figure>
              <blockquote>“{o.q}”</blockquote>
              <figcaption>{o.n}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="lista">
      <h2>Que la próxima certificación <em>la apruebes entendiendo.</em></h2>
      <p>Los de la lista se enteran primero de los cursos nuevos (y con descuento). Sin spam: te sales con un clic.</p>
      <a class="btn lime" href="/lista/">Únete a la lista</a>
    </div>
  </section>
</Base>

<style>
  .bloque {
    padding-top: 48px;
  }
  .bloque h2,
  .opiniones h2 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    color: var(--purple);
  }
  .kicker {
    margin: 0 0 4px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--deep);
  }
  .previa {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--lav);
  }
  .previa h2 {
    margin: 0 0 6px;
    color: var(--ink);
  }
  .previa p {
    margin: 0;
    color: var(--ink);
    max-width: 52ch;
  }
  .niveles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .niveles li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--lav-soft);
    border: 1.5px solid var(--line);
  }
  .niveles li.on {
    background: var(--white);
    border: 1.5px solid var(--purple);
  }
  .prof {
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--deep);
  }
  .niveles h3 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .niveles p {
    margin: 0;
    color: var(--muted);
  }
  .tag {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--white);
    color: var(--muted);
  }
  .tag.lima {
    background: var(--lime);
    color: var(--ink);
  }
  .ir {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 700;
    color: var(--deep);
    text-decoration: none;
  }
  .opiniones {
    margin-top: 56px;
    padding: 48px 0;
    background: var(--lime);
  }
  .opiniones h2 {
    color: var(--ink);
  }
  .intro {
    margin: 0 0 20px;
    color: var(--ink);
  }
  .citas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .citas figure {
    margin: 0;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--white);
    border: 1.5px solid var(--ink);
  }
  .citas blockquote {
    margin: 0 0 10px;
    font-size: 1.08rem;
    color: var(--ink);
  }
  .citas figcaption {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .lista {
    margin-top: 56px;
    padding: 40px 24px;
    border-radius: 28px;
    text-align: center;
    background: var(--purple);
    color: var(--lav);
  }
  .lista h2 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    color: var(--white);
  }
  .lista h2 em {
    color: var(--lime);
  }
  .lista p {
    max-width: 46ch;
    margin: 0 auto 20px;
  }
  @media (max-width: 992px) {
    .niveles {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 768px) {
    .niveles,
    .citas {
      grid-template-columns: 1fr;
    }
  }
</style>
